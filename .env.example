# Required: OpenRouter key used by the composer, the judge, and the OpenCode workers.
OPENROUTER_API_KEY=

# Optional web settings.
# Comma-separated pydantic-ai model ids offered in the Compose form.
# FEDOTMAS_MODELS=openrouter:qwen/qwen3.8-flash,openrouter:qwen/qwen3.7-flash
# PORT=8000
# Bearer token required for mutating API calls (start, stop, delete, reproduce).
# FEDOTMAS_WEB_TOKEN=
